      "src/feedflow/parsers/jsonfeed.py::parse_date_published",
      "src/feedflow/scheduler.py::Scheduler.next_run",
      "src/feedflow/text.py::normalize_whitespace",
      "src/feedflow/dedupe.py::normalize_url"
    ]
  },
  {
    "id": "ignore-tracking-params",
    "split": "heldout",
    "task": "The same article keeps getting stored twice because the links differ only by utm_ tracking parameters.",
