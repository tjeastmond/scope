{
  "name": "@tjeastmond/scope",
  "version": "0.1.0",
  "description": "Scope selects the smallest useful code context for a software task, using Jev to judge relevance.",
  "keywords": [
    "code-context",
    "retrieval",
    "tree-sitter",
    "coding-agent",
    "cli",
    "jev"
  ],
  "author": "TJ Eastmond",
  "homepage": "https://github.com/tjeastmond/scope#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjeastmond/scope.git"
  },
  "bugs": {
    "url": "https://github.com/tjeastmond/scope/issues"
  },
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "recall": "bun scripts/recall.ts",
    "eval": "bun scripts/eval/cli.ts",
    "eval:freeze": "bun scripts/eval/freeze-cli.ts",
    "eval:report": "bun scripts/eval/report-cli.ts",
    "eval:gate": "bun scripts/eval/gate-cli.ts",
    "utility": "bun scripts/utility-sweep.ts",
    "smoke:node": "node scripts/smoke-node.mjs",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "validate": "bun run check && bun run build && bun run test && bun run eval:gate"
  },
  "dependencies": {
    "@tree-sitter-grammars/tree-sitter-yaml": "0.7.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "ignore": "^7.0.12",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5",
    "typescript-eslint": "^8.71.1"
  },
  "bin": {
    "scope": "dist/cli.js"
  }
}
