      "src/feedflow/scheduler.py::Scheduler.record_failure",
      "src/feedflow/text.py::truncate",
      "src/feedflow/storage/memory.py::MemoryStorage.save_items",
      "src/feedflow/dedupe.py::normalize_url"
    ]
  },
  {
    "id": "pause-failing-sources",
    "split": "tuning",
    "task": "A feed that has failed five times in a row should be left alone for an hour before we try it again.",
