{
  "name": "scope",
  "version": "0.0.0",
  "description": "Scope selects the smallest useful code context for a software task, using Jev to judge relevance.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "recall": "bun scripts/recall.ts",
    "smoke:node": "node scripts/smoke-node.mjs",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "validate": "bun run check && bun run build && bun run test"
  },
  "dependencies": {
    "@tree-sitter-grammars/tree-sitter-yaml": "0.7.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "ignore": "^7.0.12",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "bin": {
    "scope": "dist/cli.js"
  }
}
