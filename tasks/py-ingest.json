      "src/feedflow/parsers/rss.py::RssParser.parse",
      "src/feedflow/text.py::strip_html"
    ]
  },
  {
    "id": "longer-summaries",
    "split": "tuning",
    "task": "Item summaries get cut off too early. Allow 1000 characters before the ellipsis shows up.",
    "required": ["src/feedflow/settings.py::DEFAULT_MAX_SUMMARY_CHARS", "src/feedflow/text.py::truncate"],
    "useful": [
      "src/feedflow/text.py::clean_summary",
