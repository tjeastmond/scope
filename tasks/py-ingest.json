    ]
  },
  {
    "id": "atom-missing-timezone",
    "split": "heldout",
    "task": "Atom entries whose timestamp has no timezone come out an hour off for our London feeds. Treat a missing zone as UTC.",
    "required": ["src/feedflow/parsers/atom.py::parse_timestamp"],
    "useful": [
      "src/feedflow/parsers/base.py::BaseParser.ensure_utc",
      "src/feedflow/parsers/atom.py::AtomParser.parse_entry"
    ],
    "irrelevant": [
