{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tjeastmond/scope/docs/scope-result.schema.json",
  "title": "Scope result (schemaVersion 2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "task", "regions", "warnings", "skipped"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "mode": { "enum": ["jev", "no-jev"] },
    "task": { "type": "string" },
    "regions": { "type": "array", "items": { "$ref": "#/$defs/region" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "skipped": { "type": "array", "items": { "$ref": "#/$defs/skipped" } },
    "retrievalConfigVersion": { "type": "string" },
    "jevQuestionVersion": { "type": "string" },
    "explain": { "const": true }
  },
  "$defs": {
    "language": {
      "enum": [
        "typescript",
        "javascript",
        "python",
        "go",
        "java",
        "rust",
        "sql",
        "html",
        "css",
        "scss",
        "json",
        "yaml",
        "toml",
        "markdown",
        "text"
      ]
    },
    "kind": {
      "enum": [
        "function",
        "method",
        "class",
        "interface",
        "type",
        "component",
        "query",
        "table",
        "style",
        "template",
        "config",
        "section",
        "file"
      ]
    },
    "score": { "type": "number", "minimum": 0 },
    "relevance": { "type": "number", "minimum": 0, "maximum": 1 },
    "line": { "type": "integer", "minimum": 1 },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "language", "startLine", "endLine", "content", "chunks"],
      "properties": {
        "file": { "type": "string" },
        "language": { "$ref": "#/$defs/language" },
        "startLine": { "$ref": "#/$defs/line" },
        "endLine": { "$ref": "#/$defs/line" },
        "content": { "type": "string" },
        "chunks": { "type": "array", "items": { "$ref": "#/$defs/chunk" } }
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "startLine", "endLine", "score", "reason"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "$ref": "#/$defs/kind" },
        "startLine": { "$ref": "#/$defs/line" },
        "endLine": { "$ref": "#/$defs/line" },
        "relevance": { "$ref": "#/$defs/relevance" },
        "score": { "$ref": "#/$defs/score" },
        "reason": { "type": "string" },
        "supportFor": { "type": "array", "items": { "type": "string" } },
        "signals": { "type": "object", "additionalProperties": { "type": "number" } },
        "origin": { "type": "string" }
      }
    },
    "skipped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunkId", "file", "startLine", "endLine", "score"],
      "properties": {
        "chunkId": { "type": "string" },
        "file": { "type": "string" },
        "startLine": { "$ref": "#/$defs/line" },
        "endLine": { "$ref": "#/$defs/line" },
        "name": { "type": "string" },
        "relevance": { "$ref": "#/$defs/relevance" },
        "score": { "$ref": "#/$defs/score" }
      }
    }
  }
}
