{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tjeastmond/scope/docs/scope-result.schema.json",
  "title": "Scope result (schemaVersion 2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "task", "regions", "warnings", "skipped"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "mode": { "enum": ["jev", "no-jev"] },
    "task": { "type": "string" },
    "regions": { "type": "array", "items": { "$ref": "#/$defs/region" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "skipped": { "type": "array", "items": { "$ref": "#/$defs/skipped" } },
    "retrievalConfigVersion": { "type": "string" },
    "jevQuestionVersion": { "type": "string" },
    "jev": { "$ref": "#/$defs/jev" },
    "decisionsReusedFrom": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$" },
    "runId": { "type": "string", "pattern": "^[0-9]{13}-[0-9a-f]{8}$" },
    "cache": { "$ref": "#/$defs/cache" },
    "explain": { "const": true }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "jev": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latencyMs", "usage"],
      "properties": {
        "requestCount": { "$ref": "#/$defs/count" },
        "latencyMs": { "$ref": "#/$defs/count" },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputTokens", "outputTokens"],
          "properties": {
            "inputTokens": { "$ref": "#/$defs/count" },
            "outputTokens": { "$ref": "#/$defs/count" }
          }
        },
        "requests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["latencyMs", "inputTokens", "outputTokens"],
            "properties": {
              "latencyMs": { "$ref": "#/$defs/count" },
              "inputTokens": { "$ref": "#/$defs/count" },
              "outputTokens": { "$ref": "#/$defs/count" }
            }
          }
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versions", "cold", "files"],
      "properties": {
        "versions": { "type": "object", "additionalProperties": { "type": "string" } },
        "cold": { "type": "boolean" },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reused", "refreshed", "removed", "refreshedPaths"],
          "properties": {
            "reused": { "$ref": "#/$defs/count" },
            "refreshed": { "$ref": "#/$defs/count" },
            "removed": { "$ref": "#/$defs/count" },
            "refreshedPaths": { "type": "array", "maxItems": 50, "items": { "type": "string" } },
            "refreshedTruncated": { "const": true }
          }
        },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reused"],
          "properties": {
            "reused": { "type": "boolean" },
            "expiresAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$" }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidates"],
          "properties": {
            "candidates": { "$ref": "#/$defs/count" },
            "disabled": { "enum": ["env", "no-history"] }
          }
        },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": { "version": { "type": "string" } }
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "runId", "similarity"],
      "properties": {
        "source": { "enum": ["missing", "useful", "selected"] },
        "runId": { "type": "string", "pattern": "^[0-9]{13}-[0-9a-f]{8}$" },
        "similarity": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "feedback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["useful", "irrelevant", "missing", "sources"],
          "properties": {
            "useful": { "$ref": "#/$defs/count" },
            "irrelevant": { "$ref": "#/$defs/count" },
            "missing": { "$ref": "#/$defs/count" },
            "sources": { "type": "array", "maxItems": 10, "items": { "type": "string" } }
          }
        }
      }
    },
    "language": {
      "enum": [
        "typescript",
        "javascript",
        "python",
        "go",
        "java",
        "rust",
        "sql",
        "html",
        "css",
        "scss",
        "json",
        "yaml",
        "toml",
        "markdown",
        "text"
      ]
    },
    "kind": {
      "enum": [
        "function",
        "method",
        "class",
        "interface",
        "type",
        "component",
        "query",
        "table",
        "style",
        "template",
        "config",
        "section",
        "file"
      ]
    },
    "score": { "type": "number", "minimum": 0 },
    "relevance": { "type": "number", "minimum": 0, "maximum": 1 },
    "line": { "type": "integer", "minimum": 1 },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "language", "startLine", "endLine", "content", "chunks"],
      "properties": {
        "file": { "type": "string" },
        "language": { "$ref": "#/$defs/language" },
        "startLine": { "$ref": "#/$defs/line" },
        "endLine": { "$ref": "#/$defs/line" },
        "content": { "type": "string" },
        "chunks": { "type": "array", "items": { "$ref": "#/$defs/chunk" } }
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "startLine", "endLine", "score", "reason"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "$ref": "#/$defs/kind" },
        "startLine": { "$ref": "#/$defs/line" },
        "endLine": { "$ref": "#/$defs/line" },
        "relevance": { "$ref": "#/$defs/relevance" },
        "score": { "$ref": "#/$defs/score" },
        "reason": { "type": "string" },
        "supportFor": { "type": "array", "items": { "type": "string" } },
        "memory": { "$ref": "#/$defs/memory" },
        "signals": { "type": "object", "additionalProperties": { "type": "number" } },
        "origin": { "type": "string" }
      }
    },
    "skipped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunkId", "file", "startLine", "endLine", "score"],
      "properties": {
        "chunkId": { "type": "string" },
        "file": { "type": "string" },
        "startLine": { "$ref": "#/$defs/line" },
        "endLine": { "$ref": "#/$defs/line" },
        "name": { "type": "string" },
        "relevance": { "$ref": "#/$defs/relevance" },
        "score": { "$ref": "#/$defs/score" }
      }
    }
  }
}
